# ==========================================================================================
#  PLANTILLA DE SECRETOS
#  ---------------------------------------------------------------------------------
#  NO subas este archivo con datos reales a GitHub.
#
#  · En local: copia este archivo como .streamlit/secrets.toml y rellénalo.
#  · En Streamlit Community Cloud: pega el contenido en
#    Manage app ▸ Settings ▸ Secrets
# ==========================================================================================

# Contraseña para entrar a ISOtools (obligatoria: sin ella la app no abre).
# Compártela solo con el personal autorizado y cámbiala si alguien deja la empresa.
[acceso]
clave = "cambia-esta-clave"

# Credencial de la cuenta de servicio de Google Cloud.
# Se obtiene del archivo JSON que descargas al crear la clave: cada campo del
# JSON va aquí como una clave del bloque.
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nPEGA_AQUI_LA_CLAVE_CON_LOS_SALTOS_COMO_\\n\n-----END PRIVATE KEY-----\n"
client_email = "control-documental@tu-proyecto.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/control-documental%40tu-proyecto.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# ------------------------------------------------------------------------------------------
# Opcional: sobrescribir los identificadores de config.py sin editar el código.
# Útil para tener un entorno de pruebas apuntando a otra hoja y otra carpeta.
